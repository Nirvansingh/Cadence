{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "1.0.0",
  "identifier": "app.cadence.productivity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cadence — Student Daily Planner & Workspace",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Cadence Open Source"
  }
}
